<?xml version="1.0"?>
<!-- Norður for Garmin watches (Connect IQ). Add your watch to <iq:products>:
     the device ids are listed in the SDK Manager (Devices tab) and in VS Code
     with "Monkey C: Edit Products". -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="94e968efa457425884a65459e5f1ffed" type="watch-app" name="@Strings.AppName" entry="NordurApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="epix2"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="venu2"/>
            <iq:product id="venu3"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>ita</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
