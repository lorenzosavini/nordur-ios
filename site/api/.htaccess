# Only index.php answers: configuration, schema and helpers are not reachable.
<FilesMatch "^(config|config\.sample|mail)\.php$|\.(sql|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
