{
  "sourceLanguage" : "it",
  "strings" : {
    "CFBundleDisplayName" : {
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "shouldTranslate" : false
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With “Always” access Norður checks weather warnings, gusts and closed roads near you even when the app is closed, and keeps recording your drive with the screen locked."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norður uses your location for weather, warnings, roads and aurora where you are, and to record your drives."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norður reads from Health the activities you choose to import (for example from Garmin Connect or Apple Watch): GPS route, distance, duration, altitude and heart rate. It writes nothing to Health."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used for the \"Find the aurora\" viewfinder, which shows you where to look in the sky. Images are never saved or sent."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion data tells where the phone is pointing, to guide you towards the aurora."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
