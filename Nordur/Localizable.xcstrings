    "Il sentiero dietro la cascata è chiuso e ghiacciato in inverno." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The path behind the waterfall is closed and icy in winter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Weg hinter dem Wasserfall ist im Winter gesperrt und vereist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sentier derrière la cascade est fermé et verglacé en hiver."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sendero detrás de la cascada está cerrado y helado en invierno."
          }
        }
      }
    },
