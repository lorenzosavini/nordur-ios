    "Strada chiusa con vento forte e in primavera per la nidificazione." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Road closed in strong wind and in spring for nesting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straße bei starkem Wind und im Frühjahr zur Brutzeit gesperrt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route fermée par vent fort et au printemps pour la nidification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera cerrada con viento fuerte y en primavera por la nidificación."
          }
        }
      }
    },
    "Onde anomale: stai lontano dall'acqua, mai di spalle al mare." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneaker waves: keep away from the water, never turn your back to the sea."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneaker Waves: Halte Abstand zum Wasser, kehr dem Meer nie den Rücken zu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagues scélérates : restez loin de l'eau, ne tournez jamais le dos à la mer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olas traicioneras: aléjate del agua, nunca des la espalda al mar."
          }
        }
      }
    },
    "Onde forti: non salire sui blocchi di ghiaccio vicino all'acqua." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
