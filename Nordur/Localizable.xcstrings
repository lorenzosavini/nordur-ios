    "Classe di osservabilità dell’aurora stanotte: attività prevista, nuvole, buio e Luna." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurora observability class tonight: expected activity, clouds, darkness and Moon."
          }
