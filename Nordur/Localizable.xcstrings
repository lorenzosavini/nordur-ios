    "Sopra %@ le portiere si aprono a fatica e i mezzi alti rischiano di ribaltarsi: tieni la portiera con due mani." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above %@ doors are hard to open and tall vehicles risk tipping over: hold the door with both hands."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über %@ lassen sich Türen schwer öffnen und hohe Fahrzeuge können umkippen: Halte die Tür mit beiden Händen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de %@, les portières sont difficiles à ouvrir et les véhicules hauts risquent de basculer : tenez la portière à deux mains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por encima de %@ las puertas cuestan de abrir y los vehículos altos pueden volcar: sujeta la puerta con las dos manos."
          }
        }
      }
    },
    "Sopra 25 m/s le portiere si aprono a fatica e i mezzi alti rischiano di ribaltarsi: tieni la portiera con due mani." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above 25 m/s doors are hard to open and tall vehicles risk tipping over: hold the door with both hands."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über 25 m/s lassen sich Türen schwer öffnen und hohe Fahrzeuge können umkippen: Halte die Tür mit beiden Händen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de 25 m/s, les portières sont difficiles à ouvrir et les véhicules hauts risquent de basculer : tenez la portière à deux mains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por encima de 25 m/s las puertas cuestan de abrir y los vehículos altos pueden volcar: sujeta la puerta con las dos manos."
          }
        }
      }
    },
