    "Variazione del campo orizzontale nell'ultima ora: sotto 50 nT calmo, da 150 nT aurora probabile sopra l'Islanda, oltre 400 nT tempesta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change of the horizontal field in the last hour: below 50 nT quiet, from 150 nT aurora likely over Iceland, above 400 nT storm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderung des Horizontalfelds in der letzten Stunde: unter 50 nT ruhig, ab 150 nT Polarlicht über Island wahrscheinlich, über 400 nT Sturm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variation du champ horizontal sur la dernière heure : sous 50 nT calme, dès 150 nT aurore probable sur l'Islande, au-delà de 400 nT tempête."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variación del campo horizontal en la última hora: por debajo de 50 nT calma, desde 150 nT aurora probable sobre Islandia, por encima de 400 nT tormenta."
          }
        }
      }
    },
