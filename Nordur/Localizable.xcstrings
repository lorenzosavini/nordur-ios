    },
    "NASA (WSA-ENLIL) prevede l'arrivo verso %@ ±7 h, %@. L'effetto dipende dal Bz all'arrivo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA (WSA-ENLIL) forecasts arrival around %1$@ ±7 h, %2$@. The effect depends on Bz on arrival."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA (WSA-ENLIL) sagt die Ankunft gegen %1$@ ±7 h voraus, %2$@. Die Wirkung hängt vom Bz bei Ankunft ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La NASA (WSA-ENLIL) prévoit l'arrivée vers %1$@ ±7 h, %2$@. L'effet dépend du Bz à l'arrivée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La NASA (WSA-ENLIL) prevé la llegada hacia %1$@ ±7 h, %2$@. El efecto depende del Bz a la llegada."
          }
        }
      }
    },
    "NASA DONKI" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI"
          }
        }
      }
    },
    "NASA DONKI (Goddard CCMC) non risponde: CME e tempeste NASA non sono incluse finché il servizio non torna disponibile. Restano attivi ENLIL di NOAA e gli avvisi NOAA." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI (Goddard CCMC) is not responding: NASA CMEs and storms are not included until the service is back. NOAA ENLIL and NOAA alerts remain active."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI (Goddard CCMC) antwortet nicht: CMEs und Stürme der NASA fehlen, bis der Dienst wieder verfügbar ist. ENLIL der NOAA und NOAA-Warnungen bleiben aktiv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI (Goddard CCMC) ne répond pas : les CME et tempêtes NASA ne sont pas incluses tant que le service n'est pas rétabli. ENLIL et les alertes de la NOAA restent actifs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA DONKI (Goddard CCMC) no responde: las CME y tormentas de la NASA no se incluyen hasta que vuelva el servicio. Siguen activos ENLIL de NOAA y los avisos de NOAA."
          }
        }
      }
    },
