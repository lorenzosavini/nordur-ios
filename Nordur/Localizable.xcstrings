          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis le menu de partage : Instagram (story ou post), WhatsApp, ou « Enregistrer l'image/la vidéo » dans Photos. Le relief 3D et le satellite proviennent de Plans d'Apple."
          }
        },
