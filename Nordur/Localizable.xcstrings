    "%@: per ora solo in Islanda, per la tua zona non ci sono dati. Meteo, mare, qualità dell'aria e aurora restano attivi." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Iceland only, for now; there are no data for your area. Weather, sea, air quality and aurora still work here."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: vorerst nur in Island, für deine Gegend gibt es keine Daten. Wetter, Meer, Luftqualität und Polarlicht funktionieren weiterhin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : pour l'instant en Islande uniquement ; aucune donnée pour votre zone. Météo, mer, qualité de l'air et aurore restent disponibles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: de momento solo Islandia; no hay datos para tu zona. El tiempo, el mar, la calidad del aire y la aurora siguen funcionando."
          }
        }
      }
    },
