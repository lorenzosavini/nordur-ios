    "Tappa: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop: %@"
          }
        }
      }
    },
    "Google non permette ad altre app di scaricare le sue mappe: Norður apre Google Maps sulla zona giusta e il download lo avvii tu. Le mappe offline di Google scadono dopo un anno se non le aggiorni." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google does not let other apps download its maps: Norður opens Google Maps on the right area and you start the download. Google offline maps expire after a year unless updated."
          }
        }
      }
    },
