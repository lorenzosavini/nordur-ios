    "Accedi per attivare il backup" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to turn on backup"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um das Backup zu aktivieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
