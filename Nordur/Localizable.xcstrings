    "Spiaggia nera – onde anomale" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black beach – sneaker waves"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarzer Strand – Sneaker Waves"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plage noire – vagues scélérates"
          }
        },
        "es" : {
          "stringUnit" : {
