    },
    "L'ora migliore: %@. Ti avviso quando è il momento: tieni attiva la sorveglianza aurora." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best time: %@. I’ll let you know when it’s time: keep aurora watch switched on."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Zeit: %@. Ich sage dir Bescheid, wenn es so weit ist: Lass die Polarlicht-Überwachung aktiviert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur moment : %@. Je vous préviens le moment venu : gardez la surveillance des aurores activée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor hora: %@. Te aviso cuando llegue el momento: mantén activada la vigilancia de auroras."
          }
        }
      }
    },
    "È ancora chiaro: il buio arriva verso le %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s still light: darkness falls around %@."
          }
