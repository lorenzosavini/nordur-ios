    "Verde: aggiornato. Giallo: copia salvata sul telefono (senza rete o fonte lenta). Rosso: ultimo tentativo fallito." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green: up to date. Yellow: copy saved on the phone (no connection or slow source). Red: last attempt failed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grün: aktuell. Gelb: auf dem Telefon gesicherte Kopie (kein Netz oder langsame Quelle). Rot: letzter Versuch fehlgeschlagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vert : à jour. Jaune : copie enregistrée sur le téléphone (pas de connexion ou source lente). Rouge : dernière tentative échouée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde: actualizado. Amarillo: copia guardada en el teléfono (sin conexión o fuente lenta). Rojo: último intento fallido."
          }
        }
      }
    },
    "Aurora: fonti scientifiche" : {
