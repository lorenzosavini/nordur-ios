    "Esempio: 15 m/s = %lld km/h = %lld nodi. Le soglie degli avvisi restano le stesse, cambia solo come vengono mostrate." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example: 15 m/s = %lld km/h = %lld knots. Alert thresholds stay the same; only the display changes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: 15 m/s = %lld km/h = %lld Knoten. Die Warnschwellen bleiben gleich, nur die Anzeige ändert sich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple : 15 m/s = %lld km/h = %lld nœuds. Les seuils d'alerte restent les mêmes ; seul l'affichage change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejemplo: 15 m/s = %lld km/h = %lld nudos. Los umbrales de alerta no cambian; solo cambia la visualización."
          }
        }
      }
    },
