    "Accedi per modificarlo insieme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to plan it together"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um gemeinsam zu planen"
          }
        },
        "fr" : {
          "stringUnit" : {
