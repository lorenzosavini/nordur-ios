    "Il vento solare in arrivo è favorevole (Bz %@ nT da %lld min%@). Verso le %@ qui sarà buio e sereno al %lld%%." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The incoming solar wind is favourable (Bz %1$@ nT for %2$lld min%3$@). Around %4$@ it will be dark here and %5$lld%% clear."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ankommende Sonnenwind ist günstig (Bz %1$@ nT seit %2$lld min%3$@). Gegen %4$@ wird es hier dunkel und zu %5$lld %% klar sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vent solaire entrant est favorable (Bz %1$@ nT depuis %2$lld min%3$@). Vers %4$@, il fera nuit ici avec un ciel dégagé à %5$lld %%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El viento solar entrante es favorable (Bz %1$@ nT desde hace %2$lld min%3$@). Hacia las %4$@ aquí estará oscuro y despejado al %5$lld %%."
          }
        }
      }
    },
    "Stanotte, verso le %@" : {
