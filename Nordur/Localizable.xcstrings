    "Google Maps" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Maps"
          }
        }
      }
    },
    "Google Maps: foto profilo › Mappe offline › Seleziona la tua mappa, adatta il riquadro e tocca Scarica. Un riquadro copre circa un terzo dell'Islanda: apri le zone qui sotto una alla volta e scaricale." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Maps: profile picture › Offline maps › Select your own map, fit the frame and tap Download. One frame covers about a third of Iceland: open the areas below one at a time and download them."
          }
        }
      }
    },
    "Sud e Ovest (Reykjavík, Golden Circle, Vík)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "South and West (Reykjavík, Golden Circle, Vík)"
