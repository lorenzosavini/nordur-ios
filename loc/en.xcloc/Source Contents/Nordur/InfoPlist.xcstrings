      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Norður usa la tua posizione per meteo, allerte, strade e aurora dove ti trovi, e per registrare i percorsi in auto."
          }
        }
      }
    }
