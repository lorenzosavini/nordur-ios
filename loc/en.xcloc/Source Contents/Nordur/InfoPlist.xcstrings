    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La fotocamera serve per il mirino \"Trova l'aurora\": ti mostra dove guardare nel cielo. Le immagini non vengono salvate né inviate."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Norður legge da Salute le attività che scegli di importare (ad esempio da Garmin Connect o Apple Watch): percorso GPS, distanza, durata, quota e frequenza cardiaca. Non scrive nulla in Salute."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Con l'accesso «Sempre» Norður controlla allerte meteo, raffiche e strade chiuse vicino a te anche quando l'app è chiusa, e continua a registrare il percorso a schermo bloccato."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Norður usa la tua posizione per meteo, allerte, strade e aurora dove ti trovi, e per registrare i percorsi in auto."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Il sensore di movimento serve per sapere dove punta il telefono e indicarti la direzione dell'aurora."
          }
        }
      }
    }
  },
  "version" : "1.0"
