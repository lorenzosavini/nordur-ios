    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Con l'accesso «Sempre» Norður controlla allerte meteo, raffiche e strade chiuse vicino a te anche quando l'app è chiusa, e continua a registrare il percorso a schermo bloccato."
          }
