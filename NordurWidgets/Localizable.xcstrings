    "Guida impegnativa, raffiche forti vicino alle montagne. Evita camper e auto alte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demanding driving, strong gusts near mountains. Avoid campers and tall vehicles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anspruchsvolle Fahrt, starke Böen nahe den Bergen. Meide Camper und hohe Fahrzeuge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduite exigeante, fortes rafales près des montagnes. Évitez camping-cars et véhicules hauts."
