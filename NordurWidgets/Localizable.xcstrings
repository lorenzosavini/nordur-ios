    "Inserisci i km al ritiro dell'auto: si aggiornano a ogni percorso. Limiti: 90 km/h asfalto, 80 sterrato, 50 centri abitati." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the km when you pick up the car: they update with every drive. Limits: 90 km/h paved, 80 gravel, 50 in towns."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die km bei der Fahrzeugübernahme ein: Sie werden mit jeder Fahrt aktualisiert. Limits: 90 km/h Asphalt, 80 Schotter, 50 innerorts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le kilométrage à la prise du véhicule : il se met à jour à chaque trajet. Limites : 90 km/h asphalte, 80 piste, 50 agglomération."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce los km al recoger el coche: se actualizan con cada trayecto. Límites: 90 km/h asfalto, 80 tierra, 50 en poblaciones."
          }
        }
      }
    },
