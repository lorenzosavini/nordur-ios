    "Una CME non garantisce un'aurora: l'effetto dipende dall'orientamento del suo campo magnetico, noto solo all'arrivo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CME does not guarantee an aurora: the effect depends on the orientation of its magnetic field, known only on arrival."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein CME garantiert kein Polarlicht: Die Wirkung hängt von der Ausrichtung seines Magnetfelds ab, die erst bei Ankunft bekannt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une CME ne garantit pas une aurore : l'effet dépend de l'orientation de son champ magnétique, connue seulement à l'arrivée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una CME no garantiza una aurora: el efecto depende de la orientación de su campo magnético, que solo se conoce al llegar."
          }
        }
      }
    },
