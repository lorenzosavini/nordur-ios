    "BUIO: ore con il Sole sotto −12° (crepuscolo nautico o più scuro). LUNA: illuminazione a mezzanotte locale." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DARK: hours with the Sun below −12° (nautical twilight or darker). MOON: illumination at local midnight."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DUNKEL: Stunden mit der Sonne unter −12° (nautische Dämmerung oder dunkler). MOND: Beleuchtung um Mitternacht Ortszeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSCURITÉ : heures avec le Soleil sous −12° (crépuscule nautique ou plus sombre). LUNE : illumination à minuit local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSCURO: horas con el Sol por debajo de −12° (crepúsculo náutico o más oscuro). LUNA: iluminación a medianoche local."
          }
        }
      }
    },
