    "Giallo: possibili disagi.\nArancione: impatti significativi, valuta di rimandare.\nRosso: evento estremo, non metterti in viaggio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yellow: possible disruption.\nOrange: significant impact, consider postponing.\nRed: extreme event, do not travel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelb: mögliche Beeinträchtigungen.\nOrange: erhebliche Auswirkungen, erwäge eine Verschiebung.\nRot: Extremereignis, reise nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaune : perturbations possibles.\nOrange : impact important, envisagez de reporter.\nRouge : événement extrême, ne prenez pas la route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amarillo: posibles incidencias.\nNaranja: impacto significativo, plantéate aplazar.\nRojo: evento extremo, no viajes."
          }
        }
      }
    },
