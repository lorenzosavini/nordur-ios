    "Arrivo di materiale di CME previsto sulla Terra: %@ (barre arancioni). L'intensità dipenderà dal Bz all'arrivo, misurabile solo ~1 ora prima a L1." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CME material forecast at Earth: %@ (orange bars). The intensity will depend on Bz on arrival, measurable only ~1 hour before at L1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CME-Material an der Erde erwartet: %@ (orange Balken). Die Stärke hängt vom Bz bei Ankunft ab, messbar erst ~1 Stunde vorher an L1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivée prévue de la CME sur Terre : %@ (barres orange). L'intensité dépendra du Bz à l'arrivée, mesurable seulement ~1 heure avant à L1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsión de llegada del material de la CME a la Tierra: %@ (barras naranjas). La intensidad dependerá de Bz a su llegada, medible solo ~1 hora antes en L1."
          }
        }
      }
    },
