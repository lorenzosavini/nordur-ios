    "NASA (WSA-ENLIL) prevede l'arrivo verso %@ ±7 h, %@. L'effetto dipende dal Bz all'arrivo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA (WSA-ENLIL) forecasts arrival around %1$@ ±7 h, %2$@. The effect depends on Bz on arrival."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASA (WSA-ENLIL) sagt die Ankunft gegen %1$@ ±7 h voraus, %2$@. Die Wirkung hängt vom Bz bei Ankunft ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La NASA (WSA-ENLIL) prévoit l'arrivée vers %1$@ ±7 h, %2$@. L'effet dépend du Bz à l'arrivée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La NASA (WSA-ENLIL) prevé la llegada hacia %1$@ ±7 h, %2$@. El efecto depende del Bz a la llegada."
          }
        }
      }
    },
