      {
        "comment": "",
        "key": "%@ · ARRIVO %@ ±%lld H",
        "location": {
          "startingColumn": 34,
          "startingLine": 793
        }
      },
      {
        "comment": "",
        "key": "Kp atteso da NASA %@–%@",
        "location": {
          "startingColumn": 103,
          "startingLine": 795
        }
      },
      {
        "comment": "",
        "key": "Tendenza 27 giorni",
        "location": {
          "startingColumn": 64,
          "startingLine": 825
        }
      },
      {
        "comment": "",
        "key": "INDICAZIONE PRELIMINARE",
        "location": {
          "startingColumn": 115,
          "startingLine": 825
        }
      },
      {
        "comment": "",
        "key": "NOAA pubblica ogni settimana il Kp massimo atteso per giorno, basato sulla rotazione solare di 27 giorni (ricorrenza dei buchi coronali). Non esiste una previsione affidabile di aurora o nuvole a queste distanze: qui trovi attività attesa, ore di buio e Luna. Il dettaglio aumenta avvicinandosi alla data.",
        "location": {
          "startingColumn": 18,
          "startingLine": 826
        }
      },
      {
        "comment": "",
        "key": "Tendenza a 27 giorni non disponibile",
        "location": {
          "startingColumn": 54,
          "startingLine": 829
        }
      },
      {
        "comment": "",
        "key": "BUIO: ore con il Sole sotto −12° (crepuscolo nautico o più scuro). LUNA: illuminazione a mezzanotte locale.",
        "location": {
          "startingColumn": 22,
          "startingLine": 850
        }
      },
